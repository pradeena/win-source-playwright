# Copy this file to .env locally, then fill in the values for the environment
# you want to test. Do not commit the .env file.

# Site under test. Leave unset for the live site, or point at a UAT, e.g.
# BASE_URL=https://uat1.example.com
BASE_URL= https://perfdev.win-source.net/

# Value of the x-ws-automation-key header for this environment.
WS_AUTOMATION_KEY=

WIN_SOURCE_EMAIL=your-email@example.com
WIN_SOURCE_PASSWORD=your-password
